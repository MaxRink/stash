# Build the fork's compatible Stash binary while preserving the validated
# generation/Python runtime image and all of its installed plugin dependencies.
ARG RUNTIME_BASE=maxrink/stash:v0.31.1-ui-2643130-runtime
FROM node:24-alpine AS ui
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /stash/ui/v2.5
COPY ui/v2.5/package.json ui/v2.5/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY ui/v2.5/ ./
COPY graphql/ /stash/graphql/
RUN pnpm run gqlgen && pnpm run build

FROM golang:1.26.10-alpine AS build
RUN apk add --no-cache make alpine-sdk
WORKDIR /stash
COPY go* ./*.go Makefile gqlgen.yml .gqlgenc.yml /stash/
COPY graphql /stash/graphql/
COPY scripts /stash/scripts/
COPY pkg /stash/pkg/
COPY cmd /stash/cmd/
COPY internal /stash/internal/
COPY ui /stash/ui/
COPY --from=ui /stash/ui/v2.5/build /stash/ui/v2.5/build
RUN test -s /stash/ui/v2.5/build/index.html
RUN make generate-backend generate-login-locale
# No .git in the build context: pass the version and source hash explicitly.
ARG STASH_VERSION GITHASH
ENV STASH_VERSION=${STASH_VERSION} GITHASH=${GITHASH}
RUN test -n "$STASH_VERSION" && test -n "$GITHASH"
RUN make flags-release flags-pie stash

# Runtime base: the validated generation/Python image (FFmpeg, plugin deps);
# only the Stash binary is replaced.
FROM ${RUNTIME_BASE}
COPY --from=build /stash/stash /usr/bin/stash
